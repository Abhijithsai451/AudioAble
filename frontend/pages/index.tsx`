import React, { useState, useEffect, useRef } from 'react';
import axios from 'axios';
import { Upload, Play, Pause, SkipForward, SkipBack, Volume2, BookOpen, Loader2, CheckCircle2, Menu, X, Trash2 } from 'lucide-react';

const API_BASE = "http://localhost:8000";

export default function Home() {
  const [view, setView] = useState<'home' | 'reader'>('home');
  const [library, setLibrary] = useState<{file_id: string, name: string, status: string}[]>([]);
  const [isLibraryOpen, setIsLibraryOpen] = useState(false);
  const [file, setFile] = useState<File | null>(null);
  const [fileId, setFileId] = useState<string | null>(null);
  const [chunks, setChunks] = useState<string[]>([]);
  const [currentChunk, setCurrentChunk] = useState(0);
  const [isPlaying, setIsPlaying] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [processingStatus, setProcessingStatus] = useState<{ progress: number; total: number; status: string } | null>(null);
  const [hasText, setHasText] = useState(false);

  const audioRef = useRef<HTMLAudioElement | null>(null);
  const fileInputRef = useRef<HTMLInputElement | null>(null);

  const fetchLibrary = async () => {
    try {
      const response = await axios.get(`${API_BASE}/library`);
      setLibrary(response.data);
    } catch (e) {
      console.error("Error fetching library", e);
    }
  };

  useEffect(() => {
    fetchLibrary();
  }, []);

  useEffect(() => {
    let interval: NodeJS.Timeout;
    if (fileId) {
      interval = setInterval(async () => {
        try {
          const response = await axios.get(`${API_BASE}/status/${fileId}`);
          setProcessingStatus(response.data);
          if (response.data.chunks) {
            setChunks(response.data.chunks);
            setHasText(true);
          }
        } catch (e) {
          console.error("Polling error", e);
        }
      }, 1500);
    }
    return () => { if (interval) clearInterval(interval); };
  }, [fileId]);

  const handleFileUpload = async (selectedFile?: File) => {
    const fileToUpload = selectedFile || file;
    if (!fileToUpload) return;
    setIsLoading(true);
    const formData = new FormData();
    formData.append('file', fileToUpload);

    try {
      const response = await axios.post(`${API_BASE}/upload`, formData);
      setFileId(response.data.file_id);
      setCurrentChunk(0);
      setView('reader');
      setProcessingStatus({ progress: 0, total: response.data.total_chunks, status: 'processing' });
      await fetchLibrary();
    } catch (error) {
      alert("Error uploading file");
    } finally {
      setIsLoading(false);
    }
  };

  const deleteBook = async (id: string) => {
    if (!confirm("Are you sure you want to delete this book?")) return;
    try {
      await axios.delete(`${API_BASE}/delete/${id}`);
      await fetchLibrary();
      if (fileId === id) {
        setFileId(null);
        setView('home');
        setHasText(false);
      }
    } catch (e) {
      alert("Error deleting book");
    }
  };

  const selectBook = async (id: string, name: string) => {
    setFileId(id);
    setCurrentChunk(0);
    setView('reader');
    try {
      const response = await axios.get(`${API_BASE}/status/${id}`);
      setProcessingStatus(response.data);
      if (response.data.chunks) {
        setChunks(response.data.chunks);
        setHasText(true);
      } else {
        setHasText(false);
      }
    } catch (e) {
      console.error("Error loading book", e);
    }
  };

  const playCurrentChunk = async () => {
    if (!fileId) return;
    const audioUrl = `${API_BASE}/generate-chunk/${fileId}/${currentChunk}`;
    if (audioRef.current) {
      audioRef.current.src = audioUrl;
      audioRef.current.play().catch(e => console.log("Playback failed", e));
    }
  };

  useEffect(() => {
    if (isPlaying && fileId) {
      playCurrentChunk();
    }
  }, [isPlaying, currentChunk]);

  const handleAudioEnd = () => {
    if (currentChunk < chunks.length - 1) {
      setCurrentChunk(prev => prev + 1);
    } else {
      setIsPlaying(false);
    }
  };

  const renderHome = () => (
    <div className="bg-white/80 backdrop-blur-sm p-16 rounded-[3rem] shadow-2xl w-full max-w-xl flex flex-col items-center gap-8 border border-teal-100 transition-all hover:shadow-teal-100/50">
      <div className="text-center mb-4">
        <div className="w-24 h-24 bg-teal-50 rounded-full flex items-center justify-center mx-auto mb-6 ring-8 ring-teal-50/50">
          <Upload size={48} className="text-teal-600 animate-bounce" />
        </div>
        <h1 className="text-3xl font-bold text-slate-800 mb-2">Your Audio Library</h1>
        <p className="text-slate-500 text-lg">Upload an ebook to transform it into a personal audiobook</p>
      </div>
      <div className="w-full flex flex-col items-center gap-6">
        <div className="relative w-full max-w-sm">
          <label
            htmlFor="file-upload"
            className="flex items-center justify-between gap-3 px-8 py-5 bg-slate-50 text-slate-700 rounded-2xl cursor-pointer hover:bg-teal-50 hover:text-teal-700 transition-all duration-300 border-2 border-dashed border-slate-200 hover:border-teal-300 font-medium group"
          >
            <span className="truncate flex items-center gap-2">
              <Upload size={18} className="text-slate-400 group-hover:text-teal-500" />
              {file ? file.name : "Select Book File"}
            </span>
            {file && (
              <button
                type="button"
                onClick={(e) => { e.preventDefault(); setFile(null); }}
                className="p-1 bg-white rounded-full shadow-sm hover:bg-red-50 hover:text-red-500 transition-all ml-2"
              >
                <X size={16} />
              </button>
            )}
          </label>
        </div>

        <button
          onClick={() => handleFileUpload()}
          disabled={!file || isLoading}
          className="w-full max-w-sm py-5 bg-gradient-to-r from-teal-600 to-teal-500 text-white rounded-2xl disabled:from-slate-300 disabled:to-slate-400 font-bold text-xl hover:from-teal-500 hover:to-teal-400 transition-all transform hover:scale-105 shadow-lg shadow-teal-200"
        >
          {isLoading ? (
            <span className="flex items-center justify-center gap-2">
              <Loader2 className="animate-spin" size={24} /> Processing...
            </span>
          ) : "Begin Conversion"}
        </button>
      </div>
    </div>
  );

  const renderReader = () => {
    if (!hasText) {
      return (
        <div className="bg-white p-16 rounded-[3rem] shadow-xl w-full max-w-lg flex flex-col items-center gap-8 border border-teal-100">
          <div className="relative">
            <Loader2 className="animate-spin text-teal-600" size={64} />
            <div className="absolute inset-0 flex items-center justify-center">
              <span className="text-xs font-bold text-teal-900">...</span>
            </div>
          </div>
          <div className="text-center">
            <p className="text-2xl font-semibold text-slate-800 mb-2">Preparing your book...</p>
            <p className="text-slate-500 italic">Extracting text and mapping pages</p>
          </div>
          <div className="w-full bg-slate-100 rounded-full h-3 overflow-hidden border border-slate-200">
            <div className="bg-teal-600 h-full w-1/3 animate-pulse" />
          </div>
          <p className="text-slate-600 font-medium">Just a moment...</p>
        </div>
      );
    }

    return (
      <div className="relative w-full max-w-3xl bg-[#fffefc] rounded-r-3xl rounded-l-sm shadow-2xl border-l-[16px] border-slate-800 h-[70vh] flex flex-col transition-all overflow-hidden ring-1 ring-slate-200">
        {/* Top Section - 20% */}
        <div className="h-1/5 flex flex-col items-center justify-center gap-3 p-6 border-b border-slate-100 bg-gradient-to-b from-slate-50 to-transparent">
          <div className="flex items-center gap-2 text-teal-600 font-bold tracking-widest uppercase text-[10px] md:text-xs bg-teal-50 px-3 py-1 rounded-full">
            {processingStatus?.status === 'completed' ? (
              <><CheckCircle2 size={14} /> Ready for Listening</>
            ) : (
              <><Loader2 size={14} className="animate-spin" /> Processing Audio in Background</>
            )}
          </div>
          <div className="text-slate-400 font-medium italic text-xs">Page {currentChunk + 1} of {chunks.length}</div>
        </div>

        {/* Bottom Section - 80% */}
        <div className="h-4/5 flex flex-col justify-between relative">
          <div className="flex-1 overflow-y-auto p-10 md:p-16 text-center">
            <p className="text-xl md:text-3xl font-serif text-slate-800 leading-relaxed transition-opacity duration-500 px-4 py-2">
              {chunks[currentChunk]}
            </p>
          </div>

          <div className="flex items-center justify-between p-8 border-t border-slate-100 bg-white/50 backdrop-blur-sm shrink-0">
            <button
              onClick={() => {
                setIsPlaying(false);
                setCurrentChunk(prev => Math.max(0, prev - 1));
              }}
              disabled={currentChunk === 0}
              className="p-4 md:p-6 rounded-full text-slate-400 hover:text-teal-600 hover:bg-teal-50 transition-all disabled:opacity-20 transform hover:scale-110"
            >
              <SkipBack size={28} className="md:w-10 md:h-10" />
            </button>

            <button
              onClick={() => setIsPlaying(!isPlaying)}
              className="p-8 rounded-full bg-slate-900 text-white hover:bg-teal-700 shadow-2xl transition-all transform hover:scale-110 active:scale-95 ring-4 ring-slate-100"
            >
              {isPlaying ? <Pause size={40} className="md:w-12 md:h-12" /> : <Play size={40} className="md:w-12 md:h-12" />}
            </button>

            <button
              onClick={() => {
                setIsPlaying(false);
                setCurrentChunk(prev => Math.min(chunks.length - 1, prev + 1));
              }}
              disabled={currentChunk === chunks.length - 1}
              className="p-4 md:p-6 rounded-full text-slate-400 hover:text-teal-600 hover:bg-teal-50 transition-all disabled:opacity-20 transform hover:scale-110"
            >
              <SkipForward size={28} className="md:w-10 md:h-10" />
            </button>
          </div>

          <div className="py-6 flex items-center justify-center gap-2 text-slate-400 text-[10px] md:text-xs italic bg-white/80 shrink-0">
            <Volume2 size={14} />
            <span className="text-sm font-medium">Hifi Audio Engine • Localized Processing</span>
          </div>
        </div>
      </div>
    );
  };

  return (
    <div className="min-h-screen w-full bg-[#FAF9F6] font-sans relative overflow-hidden flex flex-col text-slate-900">
      <nav className="w-full p-8 flex justify-start items-start z-20">
        <div className="flex flex-col items-start gap-4 relative">
          <div
            className="flex items-center gap-3 cursor-pointer group transition-all"
            onClick={() => setView('home')}
          >
            <div className="bg-teal-600 p-2 rounded-xl shadow-lg group-hover:bg-teal-500 transition-colors">
              <BookOpen size={28} className="text-white" />
            </div>
            <span className="text-2xl font-extrabold tracking-tight text-slate-800 group-hover:text-teal-600 transition-colors">AudioAble</span>
          </div>

          <div className="relative">
            <button
              onClick={() => { setIsLibraryOpen(!isLibraryOpen); if (!isLibraryOpen) fetchLibrary(); }}
              className="p-2 bg-white rounded-xl shadow-sm border border-slate-200 hover:border-teal-300 hover:bg-teal-50 transition-all flex items-center gap-2 px-4 text-slate-600 text-sm font-semibold"
            >
              <Menu size={18} className="text-teal-600" />
              <span>Library {isLibraryOpen && <X size={14} className="inline ml-1 text-red-400" />}</span>
            </button>

            {isLibraryOpen && (
              <div className="absolute top-full left-0 mt-3 w-80 bg-white/90 backdrop-blur-md rounded-3xl shadow-2xl border border-slate-200 py-5 z-50 animate-in fade-in slide-in-from-top-4 flex flex-col">
                <div className="px-6 py-3 border-b border-slate-100 mb-4">
                  <h2 className="text-xs font-bold text-slate-400 uppercase tracking-widest">Your Collection</h2>
                </div>
                <div className="max-h-96 overflow-y-auto px-3 space-y-2 flex-1">
                  {library.length === 0 ? (
                    <p className="text-slate-400 italic text-xs p-6 text-center">No books uploaded yet.</p>
                  ) : (
                    library.map(book => (
                      <div key={book.file_id} className="flex items-center justify-between p-3 rounded-2xl hover:bg-teal-50 transition-all group border border-transparent hover:border-teal-100">
                        <button
                          onClick={() => {
                            selectBook(book.file_id, book.name);
                            setIsLibraryOpen(false);
                          }}
                          className="flex-1 text-left truncate pr-2"
                        >
                          <div className="font-semibold text-slate-700 group-hover:text-teal-700 truncate text-sm">{book.name}</div>
                          <div className="text-[10px] font-bold text-slate-400 uppercase tracking-tighter">{book.status}</div>
                        </button>
                        <button
                          onClick={() => deleteBook(book.file_id)}
                          className="p-2 text-slate-300 hover:text-red-500 transition-all opacity-0 group-hover:opacity-100 shrink-0"
                        >
                          <Trash2 size={16} />
                        </button>
                      </div>
                    ))
                  )}
                </div>
                <div className="px-4 pt-5 flex justify-end">
                  <button
                    onClick={() => fileInputRef.current?.click()}
                    className="p-3 bg-teal-600 text-white rounded-full shadow-lg hover:bg-teal-500 transition-all transform hover:scale-110"
                    title="Upload New Book"
                  >
                    <Upload size={20} />
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>
      </nav>

      <main className="flex-1 flex items-start justify-center px-8 py-4 overflow-hidden">
        {view === 'home' ? renderHome() : renderReader()}
      </main>

      <input
        ref={fileInputRef}
        type="file"
        className="hidden"
        onChange={(e) => {
          const selectedFile = e.target.files?.[0];
          if (selectedFile) {
            setFile(selectedFile);
            handleFileUpload(selectedFile);
          }
        }}
        accept=".pdf,.epub,.mobi,.azw3"
      />
    </div>
  );
}
